# ===============================================
# PG Management System - Environment Variables
# ===============================================

# 1. Server & Security Configuration
PORT=10000
NODE_ENV=production
JWT_SECRET=pg_management_super_secret_jwt_key_2026
FRONTEND_URL=https://pgmanagement-frontend.vercel.app

# 2. Database Configuration (TiDB Cloud / MySQL)
# Leave blank to use built-in SQLite database automatically
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=your_tidb_user
# DB_PASSWORD=your_tidb_password
# DB_NAME=pg_management_db
# DB_SSL=true

# 3. Razorpay Payment Gateway (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
